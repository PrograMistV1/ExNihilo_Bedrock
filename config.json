{
	"$schema": "https://raw.githubusercontent.com/Bedrock-OSS/regolith-schemas/main/config/unified.json",
	"author": "PrograMistV1",
	"name": "ExNihilo",
	"packs": {
		"behaviorPack": "./packs/ExNihilo_BP",
		"resourcePack": "./packs/ExNihilo_RP"
	},
	"regolith": {
		"dataPath": "./packs/data",
		"filterDefinitions": {
			"bundler": {
				"url": "github.com/bedrock-core/regolith-filters",
				"version": "1.1.2"
			},
			"texture_list": {
				"url": "github.com/Bedrock-OSS/regolith-filters",
				"version": "1.1.3"
			}
		},
		"formatVersion": "1.8.0",
		"profiles": {
			"default": {
				"export": {
					"build": "standard",
					"readOnly": false,
					"target": "development"
				},
				"filters": [
					{
						"filter": "bundler"
					},
					{
						"filter": "texture_list"
					}
				]
			},
			"release": {
				"export": {
					"bpName": "'ExNihilo_BP'",
					"build": "standard",
					"readOnly": true,
					"rpName": "'ExNihilo_RP'",
					"target": "local"
				},
				"filters": [
					{
						"profile": "default"
					}
				],
				"postShell": {
					"linux": [
						"mkdir -p dist \u0026\u0026 rm -f dist/ExNihilo.mcaddon \u0026\u0026 cd build \u0026\u0026 zip -qr ../dist/ExNihilo.mcaddon ExNihilo_RP ExNihilo_BP"
					],
					"windows": [
						"Compress-Archive -Path build/ExNihilo_RP,build/ExNihilo_BP -DestinationPath dist/ExNihilo.mcaddon -Force"
					]
				}
			}
		}
	}
}